{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-sa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a1195bda-2d95-417a-a061-0f58c9c3df9b","database_name": "saeed-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f153aa04a5724af8b1f503dae51d0184" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
